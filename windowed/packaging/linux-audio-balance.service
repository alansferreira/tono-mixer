[Unit]
Description=Tono Mixer - agrupa e calibra saídas de áudio por instância
PartOf=graphical-session.target
After=graphical-session.target pipewire-pulse.service
Requires=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/audio-balance --hidden
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
